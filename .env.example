# Copiez ce fichier vers .env en local, ou configurez les variables directement dans AlwaysData.
# Ne publiez jamais le vrai fichier .env, ni de mot de passe ou de clé API.

# Port local ; AlwaysData fournit généralement PORT automatiquement.
PORT=8100

# Aucun produit, annonce, sondage ou vote n’est inséré automatiquement au démarrage.
# Les lignes précédemment ajoutées à titre illustratif sont nettoyées par code exact ;
# les réponses et bulletins associés sont préservés.

# Secret de session : remplacez par une chaîne aléatoire longue (au moins 32 caractères).
# Changer cette valeur invalide les sessions administrateur en cours.
SESSION_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_LONG

# Secret de chiffrement des exports des outils Notes/Bloc-notes.
# IMPORTANT : conservez exactement le secret déjà utilisé en production pour relire les anciens exports.
ENCRYPTION_SECRET=REMPLACER_PAR_UN_AUTRE_SECRET_ALEATOIRE

# Accès admin boutique/e-commerce/restaurant. Utilisez trois mots de passe distincts.
# Sans mot de passe défini, la connexion admin est désactivée (pas de mot de passe de secours public).
ADMIN_PASSWORD_BOUTIQUE=
ADMIN_PASSWORD_ECOMMERCE=
ADMIN_PASSWORD_RESTAURANT=
ADMIN_PASSWORD=

# SMTP existant du portfolio (Nodemailer) — gardez les identifiants actuels dans AlwaysData.
EMAIL_HOST=smtp-pibody.alwaysdata.net
EMAIL_PORT=587
EMAIL_USER=pibody@alwaysdata.net
EMAIL_PASSWORD=
EMAIL_TO=elfriedzannou@gmail.com

# Pibody IA et Quiz IA : facultatif ; configurez une ou plusieurs clés pour activer les réponses.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Facultatif pour les tests/staging. Par défaut, la base reste data/portfolio.sqlite.
# PORTFOLIO_DB_PATH=
# SESSION_STORE_PATH=data/sessions

    <div class="contact-grid">
      <div class="contact-info-card glass reveal">
        <p class="contact-card-label">Me contacter</p>
        <a class="contact-info-row" href="mailto:elfriedzannou@gmail.com">
          <span class="ci-icon" aria-hidden="true">@</span>
          <span><span class="ci-label">Email</span><span class="ci-value">elfriedzannou@gmail.com</span></span>
        </a>
        <a class="contact-info-row" href="tel:+2290199242930">
          <span class="ci-icon" aria-hidden="true">☎</span>
          <span><span class="ci-label">Téléphone</span><span class="ci-value">+229 01 99 24 29 30</span></span>
        </a>
        <a class="contact-info-row" href="https://wa.me/2290199242930" target="_blank" rel="noopener noreferrer">
          <span class="ci-icon" aria-hidden="true">↗</span>
          <span><span class="ci-label">WhatsApp</span><span class="ci-value">Écrire sur WhatsApp</span></span>
        </a>
        <div class="contact-info-row">

<%- include('../partials/back-button') %>

<section class="projet-page">
  <div class="container">
    <div class="projet-header">
      <div class="projet-eyebrow">Projet — Outil pratique</div>
      <h1 class="projet-title">Facture / Devis</h1>
      <p class="projet-desc">Générez une facture ou un devis professionnel en PDF, avec calcul automatique des totaux et de la TVA.</p>
    </div>

    <div class="projet-panel glass" style="max-width:800px;">
      <div class="field-row-inline">
        <div class="field-row">
          <label>Type de document</label>
          <select id="docType"><option value="Facture">Facture</option><option value="Devis">Devis</option></select>
        </div>
        <div class="field-row"><label>Numéro</label><input type="text" id="docNumero" value="001"></div>
      </div>

      <div class="field-row-inline">
        <div class="field-row"><label>Client (nom)</label><input type="text" id="clientNom" placeholder="Nom du client"></div>
        <div class="field-row"><label>TVA (%)</label><input type="number" id="docTva" value="18" step="0.5"></div>
      </div>
      <div class="field-row"><label>Adresse client</label><input type="text" id="clientAdresse" placeholder="Adresse"></div>

      <h3 style="margin:24px 0 12px;">Lignes de prestation</h3>
      <div id="lignesContainer"></div>
      <button class="btn btn-ghost" id="addLigne" style="margin-top:10px;"><i class="fa-solid fa-plus"></i> Ajouter une ligne</button>

      <div class="result-box" style="margin-top:24px;">
        <div class="result-value" id="totalDisplay">0.00 €</div>
        <div class="result-label">Total TTC estimé</div>
      </div>

      <button class="btn btn-primary btn-block" id="genererBtn" style="margin-top:20px;"><i class="fa-solid fa-file-pdf"></i> Générer le PDF</button>
    </div>
  </div>
</section>

<script>
  const lignesContainer = document.getElementById('lignesContainer');

  function addLigne(designation = '', quantite = 1, prix = 0) {
    const row = document.createElement('div');
    row.className = 'field-row-inline ligne-row';
    row.style.alignItems = 'flex-end';
    row.innerHTML = `
      <div class="field-row" style="flex:3;"><input type="text" class="l-designation" placeholder="Désignation" value="${designation}"></div>
      <div class="field-row" style="flex:1;"><input type="number" class="l-quantite" placeholder="Qté" value="${quantite}" min="0"></div>
      <div class="field-row" style="flex:1;"><input type="number" class="l-prix" placeholder="Prix unit." value="${prix}" min="0" step="0.01"></div>
      <button type="button" class="btn btn-ghost l-remove" style="margin-bottom:18px;"><i class="fa-solid fa-trash"></i></button>
    `;
    row.querySelector('.l-remove').addEventListener('click', () => { row.remove(); updateTotal(); });
    row.querySelectorAll('input').forEach(inp => inp.addEventListener('input', updateTotal));
    lignesContainer.appendChild(row);
    updateTotal();
  }

  function getLignes() {
    return Array.from(document.querySelectorAll('.ligne-row')).map(row => ({
      designation: row.querySelector('.l-designation').value,
      quantite: parseFloat(row.querySelector('.l-quantite').value) || 0,
      prix: parseFloat(row.querySelector('.l-prix').value) || 0
    }));
  }

  function updateTotal() {
    const lignes = getLignes();
    const totalHT = lignes.reduce((acc, l) => acc + l.quantite * l.prix, 0);
    const tva = parseFloat(document.getElementById('docTva').value) || 0;
    const totalTTC = totalHT * (1 + tva / 100);
    document.getElementById('totalDisplay').textContent = totalTTC.toFixed(2) + ' €';
  }

  document.getElementById('addLigne').addEventListener('click', () => addLigne());
  document.getElementById('docTva').addEventListener('input', updateTotal);

  addLigne('Prestation de développement', 1, 150);

  document.getElementById('genererBtn').addEventListener('click', async () => {
    const payload = {
      type: document.getElementById('docType').value,
      numero: document.getElementById('docNumero').value,
      clientNom: document.getElementById('clientNom').value,
      clientAdresse: document.getElementById('clientAdresse').value,
      tva: document.getElementById('docTva').value,
      lignes: getLignes()
    };

    const res = await fetch('/api/pdf/facture', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    if (res.ok) {
      const blob = await res.blob();
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob); a.download = `${payload.type}_${payload.numero}.pdf`;
      document.body.appendChild(a); a.click(); a.remove();
    } else {
      alert('Erreur lors de la génération du PDF.');
    }
  });
</script>

<%- include('../partials/back-button') %>

<section class="projet-page">
  <div class="container">
    <div class="projet-header">
      <div class="projet-eyebrow">Salon actif</div>
      <h1 class="projet-title">Salon : <span class="accent-text"><%= code %></span></h1>
      <p class="projet-desc">Partagez ce code à vos amis. <span id="participantCount">1</span> participant(s) connecté(s).</p>
    </div>

    <div class="projet-panel glass" style="max-width:750px; margin:0 auto;">
      <div id="messagesBox" style="height:420px; overflow-y:auto; display:flex; flex-direction:column; gap:12px; padding:10px; margin-bottom:16px; background:var(--bg-secondary); border-radius:10px;"></div>

      <div class="field-row-inline">
        <input type="text" id="msgInput" placeholder="Votre message..." style="flex:1; padding:14px; border-radius:999px; border:1px solid var(--border-glass); background:var(--bg-secondary); color:var(--text-primary);">
        <button class="btn btn-ghost" id="fileBtn"><i class="fa-solid fa-paperclip"></i></button>
        <input type="file" id="fileInput" accept="image/*,video/*" style="display:none;">
        <button class="btn btn-primary" id="sendBtn"><i class="fa-solid fa-paper-plane"></i></button>
      </div>
      <div class="badge-info" style="margin-top:14px;"><i class="fa-solid fa-shield-halved"></i> 5 Mo max par fichier — rien n'est conservé après la fermeture du salon.</div>
    </div>
  </div>
</section>

<script src="/socket.io/socket.io.js"></script>
<script>
  const code = '<%= code %>';
  const pseudo = sessionStorage.getItem('salonPseudo') || 'Anonyme';
  const socket = io();
  const messagesBox = document.getElementById('messagesBox');
  const MAX_SIZE = 5 * 1024 * 1024;

  socket.emit('rejoindre-salon', { code });

  socket.on('participant-rejoint', (d) => { document.getElementById('participantCount').textContent = d.count; });
  socket.on('participant-parti', (d) => { document.getElementById('participantCount').textContent = d.count; });
  socket.on('salon-expire', () => { alert('Ce salon a expiré pour inactivité.'); window.location.href = '/projets/salons'; });
  socket.on('erreur', (d) => alert(d.message));

  socket.on('nouveau-message', (msg) => {
    const div = document.createElement('div');
    div.style.padding = '10px 16px';
    div.style.borderRadius = '12px';
    div.style.background = msg.pseudo === pseudo ? 'var(--accent-soft)' : 'var(--bg-primary)';
    div.style.maxWidth = '75%';
    div.style.alignSelf = msg.pseudo === pseudo ? 'flex-end' : 'flex-start';

    let content = `<strong style="font-size:0.78rem; color:var(--accent);">${msg.pseudo}</strong><br>`;
    if (msg.type === 'texte') content += `<span>${msg.contenu}</span>`;
    else if (msg.type === 'image') content += `<img src="${msg.contenu}" style="max-width:100%; border-radius:8px; margin-top:6px;">`;
    else if (msg.type === 'video') content += `<video src="${msg.contenu}" controls style="max-width:100%; border-radius:8px; margin-top:6px;"></video>`;
    content += `<div style="font-size:0.68rem; color:var(--text-muted); margin-top:4px;">${msg.heure}</div>`;
    div.innerHTML = content;
    messagesBox.appendChild(div);
    messagesBox.scrollTop = messagesBox.scrollHeight;
  });

  function sendText() {
    const texte = document.getElementById('msgInput').value.trim();
    if (!texte) return;
    socket.emit('message-texte', { code, pseudo, texte });
    document.getElementById('msgInput').value = '';
  }

  document.getElementById('sendBtn').addEventListener('click', sendText);
  document.getElementById('msgInput').addEventListener('keypress', e => { if (e.key === 'Enter') sendText(); });

  document.getElementById('fileBtn').addEventListener('click', () => document.getElementById('fileInput').click());
  document.getElementById('fileInput').addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;
    if (file.size > MAX_SIZE) { alert('Fichier trop volumineux (max 5 Mo).'); return; }
    const reader = new FileReader();
    reader.onload = () => {
      const type = file.type.startsWith('video') ? 'video' : 'image';
      socket.emit('message-media', { code, pseudo, type, data: reader.result, taille: file.size });
    };
    reader.readAsDataURL(file);
  });
</script>
